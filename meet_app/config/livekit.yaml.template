port: 7880

rtc:
  # Single-port UDP mux: all media flows over udp_port (7881). port_range_*
  # is intentionally unset, LiveKit ignores it whenever udp_port is set.
  udp_port: 7881
  tcp_port: 7881
  # Remote-peer reachability options:
  #   - use_external_ip=true: LiveKit auto-detects its public IP via STUN and
  #     advertises it in ICE candidates. Works when the container's host is
  #     the public gateway.
  #   - node_ip=<explicit>: overrides the ICE candidate IP. Use this when the
  #     container runs behind a separate public gateway (e.g. a reverse-proxy
  #     VPS that DNATs the RTC ports back to the container's host) — STUN
  #     would otherwise return the container's egress IP, not the gateway
  #     one, and remote browsers would fail to connect.
  # Leave both empty for a local single-machine dev setup and LiveKit will
  # advertise the container IP (only useful to other containers).
  use_external_ip: ${LIVEKIT_USE_EXTERNAL_IP}
  node_ip: ${LIVEKIT_NODE_IP}
  # External TURN relay for peers whose network blocks the direct RTC path
  # (strict NAT, corporate firewalls, mobile carriers). LIVEKIT_TURN_HOST is
  # empty by default; when unset, ./compose-wrapper.sh strips the turn_servers
  # block before rendering so LiveKit does not try to register a bogus relay.
  turn_servers:
    - host: ${LIVEKIT_TURN_HOST}
      port: 5349
      protocol: tls
      username: ${LIVEKIT_TURN_USER}
      credential: ${LIVEKIT_TURN_CREDENTIAL}
turn:
  # Embedded TURN listens on udp_port (443 by default) which typically
  # collides with a reverse-proxy on the same host. Disabled by default;
  # point rtc.turn_servers above at an external coturn if you need relay.
  enabled: false

keys:
#  <LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET>
  9f3b2c7a8e6d4f1c: 6a9d0a3f5e4b8c2f9a7d6e3c1b4f8a2e



